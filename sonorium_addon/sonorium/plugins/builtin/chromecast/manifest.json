{
    "id": "chromecast",
    "name": "Chromecast Speaker",
    "version": "1.0.0",
    "description": "Stream audio to Chromecast and Google Cast devices",
    "author": "Sonorium",
    "plugin_type": "speaker",
    "category": "speakers",
    "homepage": "https://github.com/synssins/sonobleedingedge",
    "dependencies": {
        "pychromecast": ">=13.0.0"
    },
    "capabilities": ["discovery", "playback", "volume"],
    "settings_schema": {
        "type": "object",
        "properties": {
            "discovery_timeout": {
                "type": "number",
                "title": "Discovery Timeout",
                "description": "Seconds to wait for Chromecast discovery",
                "default": 5,
                "minimum": 1,
                "maximum": 30
            },
            "connection_timeout": {
                "type": "number",
                "title": "Connection Timeout",
                "description": "Seconds to wait for device connection",
                "default": 10,
                "minimum": 5,
                "maximum": 60
            }
        }
    }
}
