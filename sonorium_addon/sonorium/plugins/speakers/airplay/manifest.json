{
    "id": "airplay",
    "name": "AirPlay Speaker",
    "version": "1.0.0",
    "description": "Stream audio to AirPlay devices (Apple TV, HomePod, AirPort Express, etc.)",
    "author": "Sonorium",
    "plugin_type": "speaker",
    "category": "speakers",
    "homepage": "https://github.com/synssins/sonobleedingedge",
    "dependencies": {
        "pyatv": ">=0.14.0",
        "aiohttp": ">=3.9.0"
    },
    "capabilities": ["discovery", "playback", "volume"],
    "settings_schema": {
        "type": "object",
        "properties": {
            "discovery_timeout": {
                "type": "number",
                "title": "Discovery Timeout",
                "description": "Seconds to wait for AirPlay discovery",
                "default": 10,
                "minimum": 5,
                "maximum": 60
            },
            "buffer_size": {
                "type": "number",
                "title": "Initial Buffer Size",
                "description": "Bytes to buffer before starting stream",
                "default": 32768,
                "minimum": 8192,
                "maximum": 131072
            }
        }
    }
}
