{
  "id": "dlna",
  "name": "DLNA/UPnP",
  "version": "1.0.0",
  "description": "Stream audio to DLNA/UPnP compatible speakers and media renderers",
  "author": "Sonorium",
  "plugin_type": "speaker",
  "builtin": true,
  "entry_point": "plugin.py",
  "plugin_class": "DLNAPlugin",
  "dependencies": ["async_upnp_client"],
  "settings_schema": {
    "discovery_timeout": {
      "type": "number",
      "default": 5,
      "label": "Discovery Timeout (seconds)",
      "min": 1,
      "max": 30
    },
    "auto_reconnect": {
      "type": "boolean",
      "default": true,
      "label": "Auto-reconnect on disconnect"
    }
  }
}
