{
  "id": "airplay",
  "name": "AirPlay",
  "version": "1.0.0",
  "description": "Stream audio to AirPlay compatible speakers and devices",
  "author": "Sonorium",
  "plugin_type": "speaker",
  "builtin": true,
  "entry_point": "plugin.py",
  "plugin_class": "AirPlayPlugin",
  "dependencies": ["pyatv"],
  "settings_schema": {
    "discovery_timeout": {
      "type": "number",
      "default": 5,
      "label": "Discovery Timeout (seconds)",
      "min": 1,
      "max": 30
    },
    "audio_format": {
      "type": "select",
      "default": "wav",
      "label": "Audio Format",
      "options": [
        {"value": "wav", "label": "WAV (Best compatibility)"},
        {"value": "mp3", "label": "MP3 (Compressed)"}
      ]
    }
  }
}
